<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>BECode.Bridge</RootNamespace>
    <AssemblyName>BECode.Bridge</AssemblyName>
    <!-- BECode.Bridge is a plain netstandard2.0 library: it must never take a
         reference on a Visual Studio assembly, so it builds and tests on any
         platform, including this Linux checkout. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Text.Json" Version="8.0.5" />
    <PackageReference Include="System.Memory" Version="4.5.5" />
    <PackageReference Include="System.Threading.Channels" Version="8.0.0" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- vscode/tools.manifest.json (Task 1) is the single source of truth for
         tool names, descriptions and schemas; ToolManifest.cs reads it back
         out of this assembly by LogicalName so the resource's identity does
         not depend on the relative path used here. -->
    <EmbeddedResource Include="../../../vscode/tools.manifest.json" LogicalName="BECode.Bridge.tools.manifest.json" Link="tools.manifest.json" />
  </ItemGroup>

</Project>
